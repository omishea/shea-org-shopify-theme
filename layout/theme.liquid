<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="{{ routes.root_url }}">Shea Org<span>.</span></a>
      <nav><a href="{{ routes.root_url }}#shop">Butik</a><a href="{{ routes.root_url }}#about">Fördelar</a><a href="{{ routes.root_url }}#ritual">Om oss</a></nav>
      <button class="cart-link" type="button" data-cart-open aria-label="Varukorg, {{ cart.item_count }} produkter">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7.5h12l-1 12H7l-1-12Z"/><path d="M8.5 7.5V6a3.5 3.5 0 0 1 7 0v1.5"/><path d="M9.5 11.5c.7.8 1.5 1.2 2.5 1.2s1.8-.4 2.5-1.2"/></svg>
        <span class="cart-count{% if cart.item_count == 0 %} is-hidden{% endif %}" data-cart-count>{{ cart.item_count }}</span>
      </button>
    </div>
  </header>
  <main>{{ content_for_layout }}</main>
  <footer class="site-footer"><div class="wrap footer-inner"><strong>Shea Org</strong><span>Naturliga produkter för hud, hår och välmående.</span></div></footer>

  <div class="cart-overlay" data-cart-overlay hidden></div>
  <aside class="cart-drawer" data-cart-drawer aria-hidden="true" aria-label="Din varukorg">
    <button class="cart-drawer-close" type="button" data-cart-close aria-label="Stäng varukorgen">×</button>
    <div class="cart-drawer-header"><h2>Din varukorg</h2><p data-cart-description></p></div>
    <div class="cart-drawer-body" data-cart-body></div>
    <div class="cart-drawer-footer" data-cart-footer hidden>
      <div class="cart-drawer-total"><strong>Totalt</strong><strong data-cart-total></strong></div>
      <a class="cart-checkout" href="{{ routes.cart_url }}/checkout"><svg viewBox="0 0 24 24"><path d="M14 3h7v7"/><path d="M10 14 21 3"/><path d="M18 13v7a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h7"/></svg>Till kassan</a>
    </div>
  </aside>
<script>
(()=>{const drawer=document.querySelector('[data-cart-drawer]'),overlay=document.querySelector('[data-cart-overlay]'),body=document.querySelector('[data-cart-body]'),desc=document.querySelector('[data-cart-description]'),footer=document.querySelector('[data-cart-footer]'),total=document.querySelector('[data-cart-total]'),badge=document.querySelector('[data-cart-count]');const money=(c,currency)=>new Intl.NumberFormat('sv-SE',{style:'currency',currency:currency||'SEK'}).format(c/100);const esc=s=>{const d=document.createElement('div');d.textContent=s||'';return d.innerHTML};async function getCart(){const r=await fetch('/cart.js',{headers:{Accept:'application/json'}});return r.json()}function itemHTML(i,index){const variant=i.variant_title&&i.variant_title!=='Default Title'?`<p class="cart-item-variant">${esc(i.variant_title)}</p>`:'';return `<div class="drawer-item"><div class="drawer-item-image">${i.image?`<img src="${esc(i.image)}" alt="${esc(i.product_title)}">`:''}</div><div class="drawer-item-info"><h3>${esc(i.product_title)}</h3>${variant}<p class="drawer-item-price">${money(i.final_line_price,i.currency)}</p></div><div class="drawer-item-actions"><button type="button" class="drawer-remove" data-line="${index+1}" aria-label="Ta bort"><svg viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v5M14 11v5"/></svg></button><div class="drawer-qty"><button type="button" data-line="${index+1}" data-qty="${Math.max(0,i.quantity-1)}">−</button><span>${i.quantity}</span><button type="button" data-line="${index+1}" data-qty="${i.quantity+1}">+</button></div></div></div>`}async function render(){const c=await getCart();badge.textContent=c.item_count;badge.classList.toggle('is-hidden',c.item_count===0);desc.textContent=c.item_count===0?'Din varukorg är tom':`${c.item_count} ${c.item_count===1?'vara':'varor'} i varukorgen`;if(!c.items.length){body.innerHTML='<div class="drawer-empty"><svg viewBox="0 0 24 24"><path d="M6 7.5h12l-1 12H7l-1-12Z"/><path d="M8.5 7.5V6a3.5 3.5 0 0 1 7 0v1.5"/></svg><p>Din varukorg är tom</p></div>';footer.hidden=true}else{body.innerHTML='<div class="drawer-items">'+c.items.map(itemHTML).join('')+'</div>';total.textContent=money(c.total_price,c.currency);footer.hidden=false}}async function change(line,quantity){await fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({line,quantity})});await render()}async function open(){await render();drawer.classList.add('is-open');overlay.hidden=false;requestAnimationFrame(()=>overlay.classList.add('is-open'));drawer.setAttribute('aria-hidden','false');document.body.classList.add('cart-open')}function close(){drawer.classList.remove('is-open');overlay.classList.remove('is-open');drawer.setAttribute('aria-hidden','true');document.body.classList.remove('cart-open');setTimeout(()=>overlay.hidden=true,200)}document.addEventListener('click',e=>{if(e.target.closest('[data-cart-open]')){e.preventDefault();open()}if(e.target.closest('[data-cart-close]')||e.target===overlay)close();const q=e.target.closest('[data-qty]');if(q)change(Number(q.dataset.line),Number(q.dataset.qty));const rm=e.target.closest('[data-line].drawer-remove');if(rm)change(Number(rm.dataset.line),0)});document.addEventListener('keydown',e=>{if(e.key==='Escape')close()});})();
</script>
</body>
</html>
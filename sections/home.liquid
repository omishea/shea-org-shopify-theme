<section class="hero wrap"><div class="hero-copy"><p class="eyebrow">100 % Naturligt</p><h1>{{ section.settings.heading }}</h1><p class="lead">{{ section.settings.text }}</p><a class="button" href="#shop">{{ section.settings.button_label }}</a></div><div class="hero-logo">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', alt: 'Shea Org' }}{% else %}<div class="logo-placeholder">Shea Org</div>{% endif %}</div></section><section id="shop" class="products wrap"><div class="section-head"><h2>Produkter</h2><span>Skickas från vår egen butik</span></div><div class="product-grid">{% for product in collections.all.products limit: 20 %}<article class="product-card"><a href="{{ product.url }}"><div class="product-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}</div></a><div class="product-info"><a href="{{ product.url }}"><h3>{{ product.title }}</h3></a><p>{{ product.description | strip_html | truncate: 120 }}</p><div class="product-bottom"><strong>Från {{ product.price_min | money }}</strong><a class="small-button" href="{{ product.url }}">Se produkt →</a></div></div></article>{% endfor %}</div></section><section id="about" class="benefits"><div class="wrap benefits-grid"><div><h3>Rena ingredienser</h3><p>Noga utvalda råvaror utan onödiga tillsatser.</p></div><div><h3>Fri frakt</h3><p>Vi skickar alla beställningar fraktfritt.</p></div><div><h3>Trygg handel</h3><p>Säker betalning och snabb kundservice.</p></div></div></section><section id="ritual" class="about wrap"><h2>Om Shea Org</h2><p>Vi handplockar naturliga produkter för hud, hår och välmående — från oraffinerat sheasmör till mineralrik lera. Litet sortiment, hög kvalitet och full transparens kring vad varje produkt innehåller.</p></section>{% schema %}{"name":"Shea Org startsida","settings":[{"type":"text","id":"heading","label":"Rubrik","default":"Naturliga produkter, noga utvalda för dig."},{"type":"textarea","id":"text","label":"Text","default":"Välkommen till en plats där natur och kvalitet möts. Vi erbjuder noggrant utvalda produkter med rena ingredienser som hjälper dig att vårda din kropp, stärka ditt välmående och skapa hållbara rutiner för en hälsosammare vardag."},{"type":"text","id":"button_label","label":"Knapptext","default":"Upptäck våra produkter"},{"type":"image_picker","id":"image","label":"Logotyp / hero-bild"}],"presets":[{"name":"Shea Org startsida"}]}{% endschema %}
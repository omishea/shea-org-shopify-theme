<section class="cart-route-redirect" aria-live="polite">
  <p>Öppnar din varukorg…</p>
</section>
<script>
(function () {
  function openDrawerFromCartRoute() {
    var opener = document.querySelector('[data-cart-open]');
    if (!opener) return;
    if (window.history && window.history.replaceState) {
      window.history.replaceState({}, '', '{{ routes.root_url }}');
    }
    opener.click();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', openDrawerFromCartRoute, { once: true });
  } else {
    openDrawerFromCartRoute();
  }
})();
</script>
<style>
.cart-route-redirect{min-height:calc(100vh - 164px);display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:14px}
</style>
{% schema %}{"name":"Varukorg","settings":[]}{% endschema %}
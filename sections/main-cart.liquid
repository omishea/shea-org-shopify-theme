<section class="cart-page wrap"><h1>Varukorg</h1>{% if cart.item_count == 0 %}<p>Din varukorg är tom.</p><a class="button" href="{{ routes.all_products_collection_url }}">Fortsätt handla</a>{% else %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-items">{% for item in cart.items %}<div class="cart-item">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: alt: item.product.title }}{% endif %}<div><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a><p>{{ item.variant.title }}</p><p>{{ item.final_line_price | money }}</p><input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div></div>{% endfor %}</div><div class="cart-summary"><strong>Totalt: {{ cart.total_price | money }}</strong><button class="button" type="submit" name="update">Uppdatera</button><button class="button" type="submit" name="checkout">Till kassan</button></div></form>{% endif %}</section>{% schema %}{"name":"Varukorg","settings":[]}{% endschema %}
<section class="product-page wrap"><div class="gallery">{% for image in product.images %}<div class="gallery-image">{{ image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: product.title }}</div>{% endfor %}</div><div class="product-details"><p class="eyebrow">100 % Naturligt</p><h1>{{ product.title }}</h1><div class="price">{{ product.selected_or_first_available_variant.price | money }}</div><div class="description">{{ product.description }}</div>{% form 'product', product %}<label for="variant">Välj alternativ</label><select id="variant" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>{% endfor %}</select><button class="button add-button" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Lägg i varukorg{% else %}Slutsåld{% endif %}</button>{% endform %}</div></section>{% schema %}{"name":"Produkt","settings":[]}{% endschema %}